{
  "version": "1.0.0",
  "rules": [
    {
      "id": 1,
      "priority": 1,
      "action": { "type": "block" },
      "condition": {
        "urlFilter": "*://*.doubleclick.net/*",
        "resourceTypes": ["script", "xmlhttprequest"]
      }
    },
    {
      "id": 2,
      "priority": 1,
      "action": { "type": "block" },
      "condition": {
        "urlFilter": "*://*.googlesyndication.com/*",
        "resourceTypes": ["script", "xmlhttprequest"]
      }
    },
    {
      "id": 3,
      "priority": 1,
      "action": { "type": "block" },
      "condition": {
        "urlFilter": "*://*.youtube.com/pagead/*",
        "resourceTypes": ["script", "xmlhttprequest"]
      }
    },
    {
      "id": 4,
      "priority": 1,
      "action": { "type": "block" },
      "condition": {
        "urlFilter": "*://*.youtube.com/api/stats/*",
        "resourceTypes": ["script", "xmlhttprequest"]
      }
    },
    {
      "id": 5,
      "priority": 1,
      "action": { "type": "block" },
      "condition": {
        "urlFilter": "*://*.ytimg.com/*ad*",
        "resourceTypes": ["image", "script"]
      }
    }
  ],
  "scriptlets": {
    "blockAdDivs": {
      "code": "document.querySelectorAll('[id*=ad], [class*=ad]').forEach(el => el.remove());"
    }
  }
}
